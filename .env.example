# ---------------------------------------------------------------------------
# Backend selection
# ---------------------------------------------------------------------------
# auto        use the public API when GRANOLA_API_KEY is set, else the MCP
# public-api  always use the public API (needs a Business/Enterprise key)
# mcp         always use the MCP (works on every plan; lower fidelity)
GRANOLA_SYNC_SOURCE=auto

# ---------------------------------------------------------------------------
# Public API (higher fidelity — preferred whenever available)
# ---------------------------------------------------------------------------
# Create at: Granola -> Settings -> Connectors -> Personal API Keys -> Create new key
# Requires a Business or Enterprise plan. Keys are prefixed with "grn_".
GRANOLA_API_KEY=grn_replace_me

# ---------------------------------------------------------------------------
# Granola MCP (works on every plan, including free Basic)
# ---------------------------------------------------------------------------
# No key goes here: the MCP uses browser OAuth. Run `granola-export login` once.
# The token is stored outside the archive, mode 0600, at
# $XDG_STATE_HOME/granola-exporter/mcp-oauth.json unless overridden below.
GRANOLA_MCP_URL=https://mcp.granola.ai/mcp
# GRANOLA_MCP_TOKEN_FILE=

# Optional: name a credential profile so a second Granola account gets its own
# token file (mcp-oauth-<name>.json) and its own archive subdirectory.
# Overridden by --profile. A named profile ignores GRANOLA_MCP_TOKEN_FILE
# above, which names one exact file and cannot hold a family of them.
# GRANOLA_MCP_PROFILE=

# ---------------------------------------------------------------------------
# Archive
# ---------------------------------------------------------------------------
# Where the archive is written. Relative paths resolve from the repo root.
GRANOLA_ARCHIVE_DIR=./archive
